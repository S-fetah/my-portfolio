{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "abdelfetah-safiddine.com"
        }
      ],
      "destination": "https://www.abdelfetah-safiddine.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "myportfolio-nu-bay.vercel.app"
        }
      ],
      "destination": "https://www.abdelfetah-safiddine.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/work/fennec-booking",
      "destination": "/work/fennec-booking/index.html"
    },
    {
      "source": "/work/fennec-booking/",
      "destination": "/work/fennec-booking/index.html"
    },
    {
      "source": "/work/saha-mind",
      "destination": "/work/saha-mind/index.html"
    },
    {
      "source": "/work/saha-mind/",
      "destination": "/work/saha-mind/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
